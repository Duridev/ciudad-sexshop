---
// Footer.astro
---

<footer id="contacto" class="border-t border-purple-900/40 bg-[#080614] text-gray-300 pt-16 pb-12 relative overflow-hidden">
  <!-- Subtle ambient glow in footer -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[700px] h-[250px] bg-purple-900/10 blur-[150px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-purple-900/30">
      
      <!-- Brand & Description (2 cols) -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-3 mb-4 group">
          <div class="w-11 h-11 rounded-full overflow-hidden p-0.5 bg-gradient-to-tr from-pink-500 to-purple-600 shadow-md">
            <img 
              src="/logo-ciudadsexshop.webp" 
              alt="Ciudad Sex Shop Logo" 
              class="w-full h-full object-cover rounded-full"
              width="44"
              height="44"
            />
          </div>
          <span class="text-xl font-black uppercase text-white tracking-tight">
            CIUDAD <span class="bg-gradient-to-r from-pink-400 to-purple-400 bg-clip-text text-transparent">SEX SHOP</span>
          </span>
        </a>
        <p class="text-sm text-purple-200/70 font-light max-w-sm leading-relaxed mb-6">
          Tu boutique online de placer, bienestar y sensualidad en Chile. Experiencias íntimas de alta gama con envíos anónimos y total confidencialidad.
        </p>

        <!-- Payment icons badges -->
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-lg bg-purple-950/70 border border-purple-500/20 text-[11px] font-semibold text-purple-200">
            💳 Webpay Plus
          </span>
          <span class="px-3 py-1 rounded-lg bg-purple-950/70 border border-purple-500/20 text-[11px] font-semibold text-purple-200">
            🤝 Mercado Pago
          </span>
          <span class="px-3 py-1 rounded-lg bg-purple-950/70 border border-purple-500/20 text-[11px] font-semibold text-purple-200">
            🏦 Transferencia
          </span>
        </div>
      </div>

      <!-- Ayuda -->
      <div>
        <h4 class="text-xs uppercase tracking-widest font-bold text-white mb-4">
          Ayuda
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="text-purple-200/70 hover:text-pink-300 transition-colors">Tienda</a></li>
          <li><a href="#categorias" class="text-purple-200/70 hover:text-pink-300 transition-colors">Categorías</a></li>
          <li><a href="#mas-vendidos" class="text-purple-200/70 hover:text-pink-300 transition-colors">Novedades</a></li>
          <li><a href="#contacto" class="text-purple-200/70 hover:text-pink-300 transition-colors">Contacto</a></li>
          <li><a href="https://ciudadsexshop.cl" target="_blank" rel="noopener noreferrer" class="text-purple-200/70 hover:text-pink-300 transition-colors flex items-center gap-1">Sitio Oficial <span class="text-xs">↗</span></a></li>
        </ul>
      </div>

      <!-- Políticas de Envío -->
      <div>
        <h4 class="text-xs uppercase tracking-widest font-bold text-white mb-4">
          Políticas de Envío
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#contacto" class="text-purple-200/70 hover:text-pink-300 transition-colors">Envíos 100% Discretos</a></li>
          <li><a href="#contacto" class="text-purple-200/70 hover:text-pink-300 transition-colors">Cobertura en Chile</a></li>
          <li><a href="#contacto" class="text-purple-200/70 hover:text-pink-300 transition-colors">Preguntas Frecuentes</a></li>
          <li><a href="#educacion" class="text-purple-200/70 hover:text-pink-300 transition-colors">Blog y Consejos</a></li>
        </ul>
      </div>

      <!-- Redes Sociales -->
      <div>
        <h4 class="text-xs uppercase tracking-widest font-bold text-white mb-4">
          Redes Sociales
        </h4>
        <p class="text-xs text-purple-200/60 mb-4">
          Únete a nuestra comunidad y mantente al día con ofertas y educación.
        </p>
        <div class="flex items-center gap-3">
          <!-- Facebook -->
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-9 h-9 rounded-full bg-purple-900/30 border border-purple-500/20 hover:border-pink-500 hover:bg-pink-600/30 text-white flex items-center justify-center transition-all">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <!-- Twitter / X -->
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter X" class="w-9 h-9 rounded-full bg-purple-900/30 border border-purple-500/20 hover:border-pink-500 hover:bg-pink-600/30 text-white flex items-center justify-center transition-all">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <!-- Instagram -->
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-9 h-9 rounded-full bg-purple-900/30 border border-purple-500/20 hover:border-pink-500 hover:bg-pink-600/30 text-white flex items-center justify-center transition-all">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <!-- YouTube -->
          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-9 h-9 rounded-full bg-purple-900/30 border border-purple-500/20 hover:border-pink-500 hover:bg-pink-600/30 text-white flex items-center justify-center transition-all">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright Note matching mockup -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-purple-300/50 gap-4">
      <p>
        Copyright © 2026 Ciudad Sex Shop — Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-4">
        <span>+18 Solo para mayores de edad</span>
        <span>•</span>
        <span>Privacidad Garantizada</span>
      </div>
    </div>
  </div>
</footer>
