---
// TrustBadges.astro
---

<section class="py-12 border-y border-purple-900/30 bg-[#0d0a20]/60 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Feature 1: Asistencia & Soporte -->
      <div class="flex items-center gap-5 p-4 rounded-2xl glass-panel border border-purple-500/20 group hover:border-purple-500/40 transition-colors">
        <div class="w-14 h-14 rounded-2xl bg-purple-900/40 border border-purple-500/30 flex items-center justify-center text-pink-400 group-hover:scale-110 transition-transform flex-shrink-0 shadow-lg shadow-purple-900/20">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <div>
          <h4 class="text-base font-bold text-white group-hover:text-pink-300 transition-colors">
            Fácil Ayuda & Soporte
          </h4>
          <p class="text-xs text-purple-200/70 font-light mt-1">
            Asesoría personalizada y discreta ante cualquier consulta o duda.
          </p>
        </div>
      </div>

      <!-- Feature 2: Envío 100% Discreto -->
      <div class="flex items-center gap-5 p-4 rounded-2xl glass-panel border border-purple-500/20 group hover:border-pink-500/40 transition-colors">
        <div class="w-14 h-14 rounded-2xl bg-pink-900/30 border border-pink-500/30 flex items-center justify-center text-pink-400 group-hover:scale-110 transition-transform flex-shrink-0 shadow-lg shadow-pink-900/20">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
          </svg>
        </div>
        <div>
          <h4 class="text-base font-bold text-white group-hover:text-pink-300 transition-colors">
            Envío 100% Discreto
          </h4>
          <p class="text-xs text-purple-200/70 font-light mt-1">
            Caja sellada y neutra sin logos ni alusiones al contenido del paquete.
          </p>
        </div>
      </div>

      <!-- Feature 3: Calidad y Rapidez -->
      <div class="flex items-center gap-5 p-4 rounded-2xl glass-panel border border-purple-500/20 group hover:border-indigo-500/40 transition-colors">
        <div class="w-14 h-14 rounded-2xl bg-indigo-900/40 border border-indigo-500/30 flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform flex-shrink-0 shadow-lg shadow-indigo-900/20">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <h4 class="text-base font-bold text-white group-hover:text-pink-300 transition-colors">
            Despacho Rápido & Seguro
          </h4>
          <p class="text-xs text-purple-200/70 font-light mt-1">
            Envíos a todo Chile con seguimiento en línea y pagos protegidos.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
