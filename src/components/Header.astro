---
// Header.astro
import { getOfficialCategories } from '../lib/woocommerce';

const categories = getOfficialCategories();
---

<header class="sticky top-0 z-50 w-full transition-all duration-300">
  <!-- Top Announcement Bar -->
  <div class="bg-gradient-to-r from-purple-700 via-fuchsia-600 to-pink-600 text-white text-xs sm:text-sm py-2 px-4 text-center font-medium tracking-wide flex items-center justify-center gap-2 shadow-sm">
    <span>🔒 Paga seguro con Mercado Pago & Webpay</span>
    <span class="opacity-60">•</span>
    <span>Envíos 100% discretos a todo Chile</span>
    <span class="hidden sm:inline-flex items-center gap-1 text-amber-300">⭐⭐⭐</span>
  </div>

  <!-- Main Navbar -->
  <div class="glass-panel border-b border-purple-900/30 bg-[#0c091ad9] backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-purple-400 rounded-lg p-1">
        <div class="relative w-12 h-12 rounded-full overflow-hidden p-0.5 bg-gradient-to-tr from-pink-500 to-purple-600 shadow-lg shadow-purple-500/25 group-hover:scale-105 transition-transform duration-300">
          <img 
            src="/logo-ciudadsexshop.webp" 
            alt="Ciudad Sex Shop Logo" 
            class="w-full h-full object-cover rounded-full"
            width="48"
            height="48"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold tracking-tight text-white group-hover:text-pink-300 transition-colors uppercase">
            CIUDAD <span class="bg-gradient-to-r from-pink-400 to-purple-400 bg-clip-text text-transparent">SEX SHOP</span>
          </span>
          <span class="text-[10px] uppercase tracking-widest text-purple-300/80 font-medium">Placer & Bienestar</span>
        </div>
      </a>

      <!-- Desktop Navigation Menu (Matching official sections from codigo-fuente.txt) -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2 text-sm font-medium text-gray-200">
        
        <!-- Inicio -->
        <a href="/" class="px-3.5 py-2 rounded-full hover:text-white hover:bg-purple-900/40 transition-colors">
          Inicio
        </a>

        <!-- Ver todos los productos (Explicitly requested by user) -->
        <a 
          href="/productos" 
          class="px-3.5 py-2 rounded-full text-pink-300 hover:text-white hover:bg-pink-900/30 border border-pink-500/20 hover:border-pink-500/50 transition-all font-semibold flex items-center gap-1.5"
        >
          <span class="w-2 h-2 rounded-full bg-pink-400 animate-pulse"></span>
          Todos los Productos
        </a>

        <!-- Dropdown Categorías -->
        <div class="relative group">
          <button 
            type="button"
            class="px-3.5 py-2 rounded-full hover:text-white hover:bg-purple-900/40 transition-colors flex items-center gap-1.5 cursor-pointer focus:outline-none"
          >
            Categorías
            <svg class="w-3.5 h-3.5 text-purple-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <!-- Mega Dropdown Menu -->
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 w-[560px] opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <div class="glass-card rounded-3xl p-6 shadow-2xl border border-purple-500/30 bg-[#120f2bd9] backdrop-blur-2xl">
              
              <div class="flex items-center justify-between pb-3 border-b border-purple-900/40 mb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-purple-300">Explorar por Sección</span>
                <a href="/productos" class="text-xs text-pink-400 hover:text-pink-300 font-semibold">Ver catálogo completo →</a>
              </div>

              <div class="grid grid-cols-2 gap-x-6 gap-y-2">
                {categories.map((cat) => (
                  <a 
                    href={`/categoria/${cat.slug}`} 
                    class="flex items-center justify-between px-3 py-2 rounded-xl text-gray-300 hover:text-white hover:bg-purple-900/40 transition-colors text-xs font-medium group/item"
                  >
                    <span class="flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-pink-500 group-hover/item:scale-125 transition-transform"></span>
                      <span>{cat.name}</span>
                    </span>
                    {cat.count && (
                      <span class="text-[10px] text-purple-300/60 font-mono">({cat.count})</span>
                    )}
                  </a>
                ))}
              </div>

            </div>
          </div>
        </div>

        <!-- Blog -->
        <a href="/#educacion" class="px-3.5 py-2 rounded-full hover:text-white hover:bg-purple-900/40 transition-colors">
          Blog
        </a>

        <!-- Contacto -->
        <a href="/#contacto" class="px-3.5 py-2 rounded-full hover:text-white hover:bg-purple-900/40 transition-colors">
          Contacto
        </a>
      </nav>

      <!-- Right Actions: Real-time Search & Cart (No login button) -->
      <div class="flex items-center gap-2 sm:gap-3">
        
        <!-- Live Real-time Search Trigger Button -->
        <button 
          id="search-btn"
          type="button"
          aria-label="Buscar productos en tiempo real"
          class="flex items-center gap-2 py-2 px-3.5 rounded-full bg-[#1b153b] hover:bg-purple-900/50 border border-purple-500/25 hover:border-pink-500/40 text-gray-300 hover:text-white transition-all text-xs font-medium focus:outline-none focus:ring-2 focus:ring-pink-400"
        >
          <svg class="w-4 h-4 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline">Buscar...</span>
          <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[9px] uppercase tracking-wider text-purple-300/70 bg-purple-950/80 rounded border border-purple-500/30 font-mono">Ctrl+K</kbd>
        </button>

        <!-- Cart Trigger -->
        <button 
          id="cart-btn"
          type="button"
          aria-label="Ver carrito"
          class="relative p-2.5 text-gray-300 hover:text-white hover:bg-purple-900/50 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-purple-400"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span 
            id="cart-badge"
            class="absolute -top-1 -right-1 bg-gradient-to-r from-pink-500 to-purple-600 text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center shadow-md animate-pulse"
          >
            0
          </span>
        </button>

        <!-- Mobile Menu Toggle Button -->
        <button 
          id="mobile-menu-btn"
          aria-label="Abrir menú"
          class="md:hidden p-2.5 text-gray-300 hover:text-white rounded-xl hover:bg-purple-900/40 focus:outline-none"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-6 border-t border-purple-900/40 bg-[#0d0a1ecf] backdrop-blur-xl">
      <div class="flex flex-col gap-2 pt-2">
        <a href="/" class="px-4 py-2.5 rounded-xl text-gray-200 hover:bg-purple-900/40 hover:text-white text-sm font-medium">Inicio</a>
        <a href="/productos" class="px-4 py-2.5 rounded-xl text-pink-300 font-bold hover:bg-purple-900/40 hover:text-white text-sm">✨ Todos los Productos</a>
        
        <details class="group/mobile-cat">
          <summary class="px-4 py-2.5 rounded-xl text-gray-200 hover:bg-purple-900/40 hover:text-white text-sm font-medium flex items-center justify-between cursor-pointer list-none">
            <span>Categorías</span>
            <svg class="w-4 h-4 group-open/mobile-cat:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="pl-6 pr-2 py-2 flex flex-col gap-1.5 max-h-60 overflow-y-auto">
            {categories.map((cat) => (
              <a href={`/categoria/${cat.slug}`} class="py-1 text-xs text-purple-200/80 hover:text-white">
                • {cat.name} {cat.count ? `(${cat.count})` : ''}
              </a>
            ))}
          </div>
        </details>

        <a href="/#educacion" class="px-4 py-2.5 rounded-xl text-gray-200 hover:bg-purple-900/40 hover:text-white text-sm font-medium">Blog</a>
        <a href="/#contacto" class="px-4 py-2.5 rounded-xl text-gray-200 hover:bg-purple-900/40 hover:text-white text-sm font-medium">Contacto</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Shortcut Ctrl+K / Cmd+K to open search
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      document.getElementById('search-btn')?.click();
    }
  });
</script>
